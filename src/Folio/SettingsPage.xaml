<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Folio.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Folio.Controls">
    <UserControl.Resources>
        <Style
            x:Key="SettingsSectionHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>

        <!--  The card's title already says what the switch is for  -->
        <Style BasedOn="{StaticResource DefaultToggleSwitchStyle}" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="56,20,56,36" Spacing="4">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <!--  Appearance  -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="Appearance" />
            <!--  Matches the cards: same height, icon and text columns  -->
            <Expander
                x:Name="ThemeExpander"
                MinHeight="68"
                Padding="58,8,16,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="2,0,20,0"
                            FontSize="20"
                            Glyph="&#xE790;" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="0,12,16,12"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock Text="App theme" TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                Text="Use light or dark colors, or follow Windows."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ThemeValue"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextBlockStyle}" />
                    </Grid>
                </Expander.Header>
                <RadioButtons
                    x:Name="ThemeOptions"
                    AutomationProperties.Name="App theme"
                    SelectionChanged="OnThemeChanged" />
            </Expander>
            <controls:SettingsCard Description="Round the corners of pages in the viewer." Header="Rounded page corners">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C3;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="CornersToggle"
                    AutomationProperties.Name="Rounded page corners"
                    Toggled="OnCornersToggled" />
            </controls:SettingsCard>

            <!--  History  -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="History" />
            <controls:SettingsCard Description="List opened documents on the start page and reopen them where you left off." Header="Remember recent documents">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="RecentToggle"
                    AutomationProperties.Name="Remember recent documents"
                    Toggled="OnRecentToggled" />
            </controls:SettingsCard>

            <!--  About  -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="About" />
            <controls:SettingsCard x:Name="AboutCard" Header="Folio">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock
                    x:Name="VersionText"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SecondaryTextBlockStyle}" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
