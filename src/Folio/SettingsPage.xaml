<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Folio.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Folio.Controls">
    <UserControl.Resources>
        <Style
            x:Key="SettingsSectionHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>

        <!--  The card's title already says what the switch is for  -->
        <Style BasedOn="{StaticResource DefaultToggleSwitchStyle}" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="56,20,56,36" Spacing="4">
            <TextBlock
                x:Uid="SettingsTitle"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />

            <!--  Appearance  -->
            <TextBlock
                x:Uid="SettingsAppearance"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <!--  Matches the cards: same height, icon and text columns  -->
            <Expander
                x:Name="ThemeExpander"
                MinHeight="68"
                Padding="58,8,16,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="2,0,20,0"
                            FontSize="20"
                            Glyph="&#xE790;" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="0,12,16,12"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock x:Uid="SettingsTheme" TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="SettingsThemeDescription"
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ThemeValue"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextBlockStyle}" />
                    </Grid>
                </Expander.Header>
                <RadioButtons
                    x:Name="ThemeOptions"
                    x:Uid="SettingsThemeOptions"
                    SelectionChanged="OnThemeChanged" />
            </Expander>
            <controls:SettingsCard x:Name="LanguageCard" x:Uid="SettingsLanguage">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="LanguageBox"
                    x:Uid="SettingsLanguageBox"
                    MinWidth="200"
                    SelectionChanged="OnLanguageChanged" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsCorners">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C3;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="CornersToggle"
                    x:Uid="SettingsCornersToggle"
                    Toggled="OnCornersToggled" />
            </controls:SettingsCard>

            <!--  Search  -->
            <TextBlock
                x:Uid="SettingsSearch"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="SettingsHyphenated">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE751;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="HyphenatedToggle"
                    x:Uid="SettingsHyphenatedToggle"
                    Toggled="OnHyphenatedToggled" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsQuotes">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9B1;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="QuotesToggle"
                    x:Uid="SettingsQuotesToggle"
                    Toggled="OnQuotesToggled" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="SettingsDashes">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C1;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="DashesToggle"
                    x:Uid="SettingsDashesToggle"
                    Toggled="OnDashesToggled" />
            </controls:SettingsCard>

            <!--  History  -->
            <TextBlock
                x:Uid="SettingsHistory"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="SettingsRecent">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="RecentToggle"
                    x:Uid="SettingsRecentToggle"
                    Toggled="OnRecentToggled" />
            </controls:SettingsCard>

            <!--  About  -->
            <TextBlock
                x:Uid="SettingsAbout"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingsSectionHeaderStyle}" />
            <controls:SettingsCard x:Name="AboutCard" Header="Folio">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock
                    x:Name="VersionText"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SecondaryTextBlockStyle}" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
