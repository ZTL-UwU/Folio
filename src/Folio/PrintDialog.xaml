<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Folio.PrintDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:local="using:Folio"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <!--  The dialog sizes itself to the window instead (see SizeToWindow)  -->
        <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">2000</x:Double>
        <!--
            No title or buttons of the dialog's own (without button text it drops its button bar):
            the preview fills the left side, and the title and buttons sit with the settings.
        -->
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>

        <!--  Main choices with an icon for each option, as in Edge; some have a second line  -->
        <DataTemplate x:Key="ChoiceTemplate" x:DataType="local:PrintChoice">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Glyph="{x:Bind Glyph}"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="{x:Bind Angle}" />
                    </FontIcon.RenderTransform>
                </FontIcon>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                        Text="{x:Bind Detail}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasDetail}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </ContentDialog.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            <ColumnDefinition x:Name="SettingsColumn" Width="348" />
        </Grid.ColumnDefinitions>

        <!--  Preview of one sheet at a time, as it comes out of the printer  -->
        <Grid
            x:Name="PreviewPane"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            CornerRadius="8,0,0,8"
            PointerWheelChanged="OnPreviewWheel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="PreviewHost"
                Margin="32,32,32,8"
                SizeChanged="OnPreviewSizeChanged">
                <!--  A hairline around the paper, outside it, so the paper is exactly the size it's drawn at  -->
                <Border
                    x:Name="Sheet"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Print preview"
                    BorderBrush="#26000000"
                    BorderThickness="1"
                    Visibility="Collapsed">
                    <Canvas x:Name="SheetCanvas" Background="White" />
                </Border>
                <TextBlock
                    x:Name="PreviewMessage"
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                x:Name="SheetNavigation"
                Grid.Row="1"
                Height="48"
                Margin="0,0,0,12"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="PreviousSheetButton"
                    AutomationProperties.Name="Previous sheet"
                    Click="OnPreviousSheet"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Previous sheet">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
                <TextBlock
                    x:Name="SheetPosition"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="NextSheetButton"
                    AutomationProperties.Name="Next sheet"
                    Click="OnNextSheet"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Next sheet">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Title, settings and buttons. The side margins are inside the scrolled settings rather than
            around them, so dividers there can run the full width of the column.
        -->
        <Grid
            x:Name="SettingsPane"
            Grid.Column="1"
            Padding="0,24,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="24,0,24,0"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Print" />
            <TextBlock
                x:Name="Summary"
                Grid.Row="1"
                Margin="24,2,24,16"
                Style="{StaticResource SecondaryTextBlockStyle}" />
            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="2"
                Margin="24,0,24,12"
                IsOpen="False"
                Severity="Error" />
            <ScrollViewer x:Name="SettingsScroller" Grid.Row="3">
                <StackPanel
                    x:Name="SettingsPanel"
                    Padding="24,0,24,0"
                    Spacing="12">
                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Name="PrinterBox"
                            Header="Printer"
                            PlaceholderText="Looking for printers…"
                            SelectionChanged="OnPrinterChanged" />
                        <TextBlock
                            x:Name="PrinterStatus"
                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="CopiesBox"
                            Header="Copies"
                            LargeChange="10"
                            Maximum="999"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="OnCopiesChanged"
                            Value="1" />
                        <CheckBox
                            x:Name="CollateBox"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Bottom"
                            Click="OnCountChanged"
                            Content="Collate"
                            IsChecked="True"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Print whole copies one after another, rather than all copies of each page together" />
                    </Grid>

                    <StackPanel Spacing="8">
                        <ComboBox
                            x:Name="PagesBox"
                            DropDownClosed="OnPagesDropDownClosed"
                            Header="Pages"
                            ItemTemplate="{StaticResource ChoiceTemplate}"
                            SelectionChanged="OnPagesChanged" />
                        <TextBox
                            x:Name="RangeBox"
                            AutomationProperties.Name="Pages to print"
                            PlaceholderText="For example 1-5, 8, 11-13"
                            TextChanged="OnRangeChanged"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="RangeError"
                            Style="{StaticResource CriticalTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <ComboBox
                        x:Name="OrientationBox"
                        Header="Orientation"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        SelectionChanged="OnLayoutChanged" />

                    <ComboBox
                        x:Name="ColorBox"
                        Header="Color"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        SelectionChanged="OnAppearanceChanged" />

                    <ComboBox
                        x:Name="DuplexBox"
                        Header="Print on both sides"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        SelectionChanged="OnCountChanged" />

                    <!--  A divider across the whole column, then a full-width row that shows the rest, as in Chrome  -->
                    <StackPanel Margin="-24,4,-24,0">
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            x:Name="MoreButton"
                            Padding="24,14,24,14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="More settings"
                            Click="OnToggleMore"
                            CornerRadius="0"
                            Style="{StaticResource SubtleButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="More settings" />
                                <!--
                                    The combo boxes' chevron: same glyph, colour and inset, so they line up. Its own
                                    animation can't be sped up, so it stays pointing down and the border turns it
                                    (see OnToggleMore). An animated icon follows the state of the nearest element
                                    above it that has one, so the border also keeps the button's (pointer over,
                                    pressed) from reaching it.
                                -->
                                <Border
                                    Grid.Column="1"
                                    Margin="0,0,14,0"
                                    AnimatedIcon.State="NormalOff"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="MoreChevronRotation" />
                                    </Border.RenderTransform>
                                    <AnimatedIcon
                                        Width="12"
                                        Height="12"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Foreground="{ThemeResource ComboBoxDropDownGlyphForeground}">
                                        <animatedvisuals:AnimatedChevronUpDownSmallVisualSource />
                                        <AnimatedIcon.FallbackIconSource>
                                            <FontIconSource FontSize="12" Glyph="&#xE70D;" />
                                        </AnimatedIcon.FallbackIconSource>
                                    </AnimatedIcon>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        x:Name="MoreContent"
                        Margin="0,0,0,8"
                        Spacing="12"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="PaperBox"
                            Header="Paper size"
                            SelectionChanged="OnPaperChanged" />
                        <ComboBox
                            x:Name="PerSheetBox"
                            Header="Pages per sheet"
                            SelectionChanged="OnLayoutChanged" />
                        <StackPanel Spacing="8">
                            <ComboBox
                                x:Name="ScaleBox"
                                Header="Scale"
                                SelectionChanged="OnScaleChanged" />
                            <NumberBox
                                x:Name="ScalePercentBox"
                                AutomationProperties.Name="Scale in percent"
                                LargeChange="25"
                                Maximum="400"
                                Minimum="10"
                                SmallChange="5"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnScalePercentChanged"
                                Visibility="Collapsed"
                                Value="100" />
                        </StackPanel>
                        <ComboBox
                            x:Name="SubsetBox"
                            Header="Include"
                            SelectionChanged="OnLayoutChanged" />
                        <StackPanel>
                            <CheckBox
                                x:Name="ReverseBox"
                                Click="OnLayoutChanged"
                                Content="Reverse order" />
                            <CheckBox
                                x:Name="AnnotationsBox"
                                Click="OnAppearanceChanged"
                                Content="Annotations and form fields"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="ImageBox"
                                Content="Print as image"
                                ToolTipService.ToolTip="Slower and less sharp, but can help when pages print incorrectly" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="LinksPanel" Margin="-11,0,0,0">
                        <HyperlinkButton
                            x:Name="PropertiesButton"
                            Click="OnPrinterProperties"
                            Content="Printer properties…"
                            IsEnabled="False" />
                        <HyperlinkButton Click="OnSystemDialog" Content="Print using the system dialog…" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel
                x:Name="ProgressPanel"
                Grid.Row="4"
                Margin="24,16,24,0"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" />
                <ProgressBar x:Name="PrintProgress" Maximum="1" />
            </StackPanel>
            <Grid
                Grid.Row="5"
                Margin="24,24,24,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PrintButton"
                    HorizontalAlignment="Stretch"
                    Click="OnPrintClick"
                    Content="Print"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnCancelClick"
                    Content="Cancel" />
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
