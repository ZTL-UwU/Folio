<Project Sdk="Microsoft.NET.Sdk">
  <!-- The File Explorer thumbnail handler for PDFs. Explorer loads it as a native COM server, so it's
       published with Native AOT, which needs the MSVC linker (Visual Studio's C++ build tools). Only the
       MSIX build includes and registers it; see docs/packaging.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Folio.Thumbnails</RootNamespace>
    <AssemblyName>Folio.Thumbnails</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
</Project>
